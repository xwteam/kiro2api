# 鉴权
# 主 API key。取消注释并填值;留成空串会覆盖 config.json 里已配的密钥,反而把服务变成开放模式。
# API_KEY=sk-your-key
# 管理端 key(不设则回退用 API_KEY)。对公网暴露必须设置,否则 /api/admin/* 无鉴权。
# ADMIN_API_KEY=sk-your-admin-key

# 服务
# HOST 留空即用安全默认 127.0.0.1;容器镜像已内置 ENV HOST=0.0.0.0,无需在此设置。裸机部署请勿轻易改 0.0.0.0(当前 /admin、/user 尚未接鉴权)。
# HOST=0.0.0.0
# 改这里即可换端口:compose 的端口映射与健康检查都跟随该值。
PORT=8080
REGION=us-east-1

# 用一个 Kiro API Key(ksk_ 开头)直接起服务,不必先准备 credentials.json。
# 该账号会在启动时并入账号池(已存在同名 key 则不重复导入),并随其余账号一起落盘。
# 适合容器化部署:挂载卷里没有凭据文件时,靠这一条就能跑起来。
# KIRO_API_KEY=ksk_xxx
